# Logs
/logs
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage

# Dependency directories
node_modules/
jspm_packages/
vendor/

# Output of 'npm pack'
*.tgz

# dotenv environment variables file
.env

# IDE / Editor
.idea
.vscode/settings.json

# macOS
.DS_Store

# Vim swap files
*.swp

# Asset files
assets/*.json
!assets/PlayList.json
!assets/lang.json
!assets/lang-*.json

# User-specific extension files
custom.php

# Playwright
test-results/
playwright-report/
artifacts/demo/

# Ignore built minified CSS if generated locally (keep source-controlled CSS if desired)
dist/*.min.css

# Others
*.orig
*.bak
*.bak.*
src/_*.*
package-lock.json
refuges/
.codex/
