{
  "name": "ambient",
  "version": "2.1.1",
  "scripts": {
    "ts-dev": "tsc --watch",
    "ts-build": "tsc",
    "tw-dev": "tailwindcss -i ./src/styles/tailwindcss.css -o ./dist/tailwindcss.css --watch",
    "tw-build": "tailwindcss -i ./src/styles/tailwindcss.css -o ./dist/tailwindcss.min.css --minify",
    "validate:playlists": "node ./scripts/validate-playlists.cjs",
    "test:e2e": "playwright test --project=chrome --project=ipad --project=iphone",
    "test:e2e:all": "playwright test",
    "test:e2e:debug": "playwright test --project=chrome --headed --debug"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/cli": "^4.2.4",
    "@types/node": "^20.10.0",
    "ajv": "^8.17.1",
    "flowbite": "^4.0.1",
    "playwright": "^1.59.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3"
  }
}
