{
  "name": "ambient",
  "version": "2.5.4",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "ts-dev": "tsc --noEmit --watch",
    "ts-build": "tsc --noEmit",
    "validate:playlists": "node ./scripts/validate-playlists.cjs",
    "check:i18n": "node ./scripts/check-i18n-coverage.cjs",
    "release:prepare": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/release-prepare.ps1",
    "release:start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/release-start.ps1",
    "release:finish": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/release-finish.ps1",
    "release:verify:public": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/release-verify-public-e2e.ps1",
    "test:e2e": "playwright test --project=chrome --project=ipad --project=iphone",
    "test:e2e:public": "playwright test --project=chrome --grep @public-release --workers=1 --retries=1",
    "test:e2e:prod": "npm run test:e2e:public",
    "test:e2e:all": "playwright test",
    "test:e2e:debug": "playwright test --project=chrome --headed --debug"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^20.10.0",
    "@types/sortablejs": "^1.15.9",
    "ajv": "^8.17.1",
    "flowbite": "^4.0.1",
    "playwright": "^1.59.1",
    "sass": "^1.99.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  },
  "dependencies": {
    "sortablejs": "^1.15.7"
  }
}
