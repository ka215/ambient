{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ka2.org/schemas/ambient-playlist-v2.schema.json",
  "title": "Ambient Playlist",
  "type": "object",
  "properties": {
    "options": {
      "type": "object",
      "properties": {
        "autoplay": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "number" }
          ]
        },
        "controls": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "number" }
          ]
        },
        "random": { "type": "boolean" },
        "shuffle": { "type": "boolean" },
        "seek": { "type": "boolean" },
        "fullwindow": { "type": "boolean" },
        "volume": {
          "oneOf": [
            { "type": "number", "minimum": 0 },
            { "type": "string" },
            { "type": "null" }
          ]
        },
        "fader": { "type": "boolean" },
        "dark": { "type": "boolean" },
        "background": { "type": "string" },
        "caption": { "type": "string" },
        "playlist": { "type": "string" },
        "fs": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "number" }
          ]
        },
        "cc": { "type": "boolean" },
        "cc_load_policy": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "number" }
          ]
        },
        "rel": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "number" }
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "patternProperties": {
    "^(?!options$).+": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mediaItem"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "mediaItem": {
      "type": "object",
      "properties": {
        "disc": { "type": "integer" },
        "track": { "type": "integer" },
        "title": { "type": "string" },
        "file": { "type": "string" },
        "videoid": { "type": "string" },
        "desc": { "type": "string" },
        "artist": { "type": "string" },
        "image": { "type": "string" },
        "thumb": { "type": "string" },
        "controls": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "string" },
            { "type": "integer" }
          ]
        },
        "volume": {
          "oneOf": [
            { "type": "number", "minimum": 0 },
            { "type": "string" },
            { "type": "null" }
          ]
        },
        "start": {
          "oneOf": [
            { "type": "number", "minimum": 0 },
            { "type": "string" }
          ]
        },
        "end": {
          "oneOf": [
            { "type": "number", "minimum": 0 },
            { "type": "string" }
          ]
        },
        "fadein": {
          "oneOf": [
            { "type": "number", "minimum": 0 },
            { "type": "string" }
          ]
        },
        "fadeout": {
          "oneOf": [
            { "type": "number", "minimum": 0 },
            { "type": "string" }
          ]
        },
        "fs": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "integer" }
          ]
        },
        "cc": {
          "oneOf": [
            { "type": "boolean" },
            { "type": "integer" }
          ]
        }
      },
      "required": ["title"],
      "additionalProperties": true
    }
  }
}
