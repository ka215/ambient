# Ambient environment settings
DEBUG_MODE=false
ASSETS_DIR=assets
LOGS_DIR=logs

# Deployment environment: set to "cloud" when running on a cloud server,
# or "local" (default) when running on a local PC.
# In cloud mode: local media selection and symlink creation are disabled,
# and playlist data is persisted to browser localStorage.
AMP_ENV=local

# Asset loading mode:
# - build : load built files from dist/manifest.json and dist/assets/*
# - dev   : load assets from the Vite dev server
ASSET_MODE=build

# Vite dev server URL used only when ASSET_MODE=dev.
# Example for Apache reverse proxy based local development:
# VITE_DEV_SERVER_URL=https://dev-amp.ka2.org/vite
VITE_DEV_SERVER_URL=

# Media edit seek timeline duration sync timeout in milliseconds.
# If duration is still unresolved after this timeout, timeline falls back to rangeMax.
VITE_MEDIA_EDIT_DURATION_SYNC_TIMEOUT_MS=5000
