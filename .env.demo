# Ambient demo recording environment template.
# Copy this file to .env and edit values for local demo generation.

# Demo media assets
AMP_DEMO_YOUTUBE_VIDEO_ID=M7lc1UVf-VE
AMP_DEMO_EXTRA_YOUTUBE_VIDEO_ID=dQw4w9WgXcQ
AMP_DEMO_EXTRA_YOUTUBE_TITLE=Demo added YouTube scene
AMP_DEMO_LOCAL_VIDEO_PATH=pexels-18756591.mp4
AMP_DEMO_LOCAL_AUDIO_PATH=209_BPM80.mp3

# Recording runtime
AMP_DEMO_HEADLESS=0
AMP_DEMO_FAST=0
AMP_DEMO_SLOW_MO_MS=100
AMP_DEMO_PORT=8091
AMP_DEMO_OUTPUT_NAME=ambient-demo.webm

# Optional custom cursor SVG path, relative to repository root.
# AMP_DEMO_CURSOR_SVG_PATH=tests/demo/fixtures/cursor.svg

# MP4 conversion
AMP_DEMO_MP4_FRAME_RATE=60
